# Postgres. On Supabase: DATABASE_URL is the pooled connection (port 6543,
# add ?pgbouncer=true&connection_limit=1), DIRECT_URL the direct one (5432).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mack
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mack

# Supabase Auth (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ElevenLabs. ELEVENLABS_AGENT_ID is the base agent; one agent per scenario is
# cloned from it on first use. The webhook secret comes from the post-call
# webhook in ElevenLabs settings (URL: https://<your-domain>/api/webhooks/elevenlabs).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WEBHOOK_SECRET=
# Longest allowed call, in seconds
MAX_CALL_SECONDS=600

# OpenAI, for feedback
OPENAI_API_KEY=
OPENAI_FEEDBACK_MODEL=gpt-4o-mini
